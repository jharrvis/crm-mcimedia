APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Identitas usaha (F2-2, config/crm.php) — tampil di PDF & halaman invoice publik
CRM_BUSINESS_NAME="MCI Media"
CRM_BUSINESS_ADDRESS="Jakarta, Indonesia"
CRM_BUSINESS_EMAIL="admin@mcimedia.web.id"
CRM_BUSINESS_PHONE="+62 812-3456-7890"
CRM_BUSINESS_WHATSAPP="+62 812-3456-7890"
# Logo usaha (F2-8): path file relatif terhadap public/, mis. images/business-logo.png.
# Kosongkan bila tidak memakai logo. Setelah file ditaruh, jalankan `php artisan config:cache`.
CRM_BUSINESS_LOGO=""
# Rekening bank (F2-9) — boleh lebih dari satu. Format: JSON array objek
# {name, account_number, account_holder}. Bungkus dengan tanda kutip tunggal.
# Isi nilai ASLI hanya di .env server (repo ini publik — jangan commit nomor
# rekening nyata). Contoh di bawah memakai nomor dummy.
# Kosongkan daftar = bagian instruksi pembayaran tampil tanpa rekening (tanpa error).
CRM_BANK_ACCOUNTS='[{"name":"BCA","account_number":"0000000000","account_holder":"Nama Pemilik"},{"name":"Bank Lain","account_number":"1111111111","account_holder":"Nama Pemilik"}]'
# Format lama (satu rekening) masih didukung bila CRM_BANK_ACCOUNTS kosong:
# CRM_BANK_NAME="Bank Central Asia (BCA)"
# CRM_BANK_ACCOUNT_NUMBER="0000000000"
# CRM_BANK_ACCOUNT_HOLDER="Nama Pemilik"

# Pengiriman invoice (F2-5)
# Email memakai konfigurasi mail Laravel standar di atas (MAIL_MAILER/MAIL_HOST/dst).
# WhatsApp memakai Fonnte: isi token dari dashboard Fonnte, jangan commit token asli.
FONNTE_ENABLED=false
FONNTE_TOKEN=
FONNTE_TARGET=

# Sinkronisasi HestiaCP (F3-1) — read-only. Isi nilai asli HANYA di .env server.
# Autentikasi: access/secret key (disarankan) ATAU user/password admin.
# Contoh di bawah memakai nilai dummy.
#
# F4-12 (multi-server): HESTIA_ENABLED tetap wajib true sebagai kill switch
# global, TAPI host & kredensial per-server (sg2, YIARI, PA Salatiga) kini
# dikelola dari UI CRM di /hestia/servers (kredensial disimpan terenkripsi).
# Blok di bawah hanya dipakai sebagai FALLBACK bila belum ada server UI aktif.
#   php artisan db:seed --class=HestiaServerSeeder   # 3 baris: sg2/YIARI/PA Salatiga
# aktifkan env ini, isi host & kredensial tiap server di UI, lalu config:cache.
HESTIA_ENABLED=false
HESTIA_HOST=
HESTIA_PORT=8083
HESTIA_SCHEME=https
HESTIA_VERIFY_SSL=false
HESTIA_ACCESS_KEY=
HESTIA_SECRET_KEY=
HESTIA_USER=
HESTIA_PASSWORD=
HESTIA_TIMEOUT=30
# Modul monitoring keamanan (F3-3). Isi token asli HANYA di .env server.
# Script monitoring memanggil POST /api/security/events dengan header
# "Authorization: Bearer ***" (atau "X-Api-Token: ***"
# Token kosong = endpoint API menolak semua request (503), tidak ada
# jalur tanpa autentikasi. JANGAN pernah mengirim kredensial server ke API ini.
SECURITY_API_ENABLED=true
SECURITY_API_TOKEN=
# Temuan tanpa external_id yang sama (klien+sumber+judul) dalam jendela ini
# dianggap duplikat (menit).
SECURITY_DEDUP_WINDOW_MINUTES=1440
# Disk penyimpanan PDF laporan (default: privat "local") & batas ukuran unggah (KB).
SECURITY_REPORT_DISK=local
SECURITY_REPORT_MAX_KB=10240
# CC tetap saat laporan keamanan dikirim ke klien (F4-3). Kosongkan untuk tanpa CC.
CRM_SECURITY_REPORT_CC_EMAIL=info@mcimedia.net
# Default client ID untuk webhook Uptime Kuma bila domain tidak ketemu di tabel services.
# Mengikuti konvensi CLIENT_ID push-agent. Isi ID client yang valid & aktif.
# SECURITY_UPTIME_DEFAULT_CLIENT_ID=1
