# /etc/wp-file-integrity.env — konfigurasi wp-file-integrity.sh
# Salin menjadi /etc/wp-file-integrity.env, lalu isi. Izin: root:root 600.
# Nilai JANGAN pernah berisi kredensial server WordPress — hanya token API CRM.

# Base URL CRM (wajib, tanpa trailing slash)
CRM_API_URL=https://crm.mcimedia.net

# Token API keamanan CRM (wajib). Salin dari .env CRM di server (SECURITY_API_TOKEN).
# Jangan commit nilai ini ke repo mana pun.
SECURITY_API_TOKEN=

# Client ID default di CRM untuk situs yang tidak punya client_id sendiri
# (angka; harus ada di tabel clients CRM)
CRM_CLIENT_ID=

# Opsional: peta label-situs -> client_id (JSON). Mengalahkan CRM_CLIENT_ID.
# Contoh isi file: {"example.com": 3, "blog.example.com": 4, "@server": 2}
#CRM_CLIENT_MAP_PATH=/etc/wp-file-integrity/client-map.json

# Definisi situs (wajib) — lihat contoh di paket (sites.example.json)
SITES_FILE=/etc/wp-file-integrity/sites.json

# Lokasi binary wp-cli (default: cari di PATH)
#WP_BIN=/usr/local/bin/wp

# Lokasi state & log (biarkan default kecuali testing)
#STATE_DIR=/var/lib/wp-file-integrity
#SELF_LOG=/var/log/wp-file-integrity.log

# Severity per kategori temuan (critical|high|medium|low|info)
#SEV_WATCH=critical
#SEV_CORE=high
#SEV_PLUGIN=medium

# Jumlah maks path temuan yang dicantumkan di deskripsi event
#MAX_REPORT_FILES=30

# Glob watchlist default (relatif ke root situs; dipisah spasi)
#WATCH_GLOBS="wp-config.php wp-content/mu-plugins/*.php wp-content/db.php wp-content/object-cache.php"

#HTTP_TIMEOUT=30
#OUTBOX_MAX_LINES=5000